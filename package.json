{
  "name": "@ocodejs/auth-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Central identity and authentication gateway for the Velclaw ecosystem",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/index.js",
    "db:migrate": "tsx server/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts && npm run test:worker",
    "test:worker": "node --test tests/worker.test.mjs tests/identity.test.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.2.1",
    "argon2": "^0.41.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "nodemailer": "^10.6.0",
    "pg": "^8.13.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
